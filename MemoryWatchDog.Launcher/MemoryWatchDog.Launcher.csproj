<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MemoryWatchDog.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Botomatic</Company>
    <Product>.NET MemorySpy Launcher</Product>
    <Description>Launcher that detects target process architecture and starts the correct MemoryWatchDog build.</Description>
    <Copyright>Copyright © 2026 Botomatic</Copyright>
    <ApplicationIcon>..\MemoryWatchDog.Wpf\icons8-spy-96.ico</ApplicationIcon>
  </PropertyGroup>

</Project>

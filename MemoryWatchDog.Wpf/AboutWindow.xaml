<Window x:Class="MemoryWatchDogApp.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About .NET MemorySpy" Height="300" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Product Name -->
    <TextBlock Grid.Row="0" Text=".NET MemorySpy" FontSize="22" FontWeight="Bold"
               Foreground="#1565C0" HorizontalAlignment="Center" Margin="0,0,0,8"/>

    <!-- Version -->
    <TextBlock Grid.Row="1" x:Name="VersionText" FontSize="14"
               HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,12"/>

    <!-- Description -->
    <TextBlock Grid.Row="2" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
               Foreground="#555" Margin="0,0,0,12"
               Text="A WPF tool for monitoring and diagnosing .NET application memory usage, detecting leaks, and analyzing heap objects."/>

    <!-- Company / Copyright -->
    <TextBlock Grid.Row="3" x:Name="CopyrightText" FontSize="12"
               HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,4"/>

    <TextBlock Grid.Row="4" x:Name="CompanyText" FontSize="12"
               HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,12"/>

    <!-- GitHub link -->
    <!--<TextBlock Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Hyperlink NavigateUri="https://github.com/JohnnyBravo75/MemoryWatchDog"
                       RequestNavigate="Hyperlink_RequestNavigate">
                https://github.com/JohnnyBravo75/MemoryWatchDog
            </Hyperlink>
        </TextBlock>-->

    <!-- Close button -->
    <Button Grid.Row="6" Content="OK" Width="80" HorizontalAlignment="Center"
            IsDefault="True" IsCancel="True" Click="OkButton_Click"/>
  </Grid>
</Window>

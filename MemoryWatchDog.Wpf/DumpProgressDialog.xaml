<Window x:Class="MemoryWatchDogApp.DumpProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creating Full Dump..." Height="320" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontWeight="Bold" FontSize="13"
                   Margin="0,0,0,8" TextWrapping="Wrap"/>

        <Border Grid.Row="1" BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="3" Background="#1E1E1E">
            <TextBox x:Name="OutputTextBox" Background="Transparent" Foreground="#D4D4D4"
                     FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="4" TextWrapping="Wrap"/>
        </Border>

        <TextBlock x:Name="ResultText" Grid.Row="2" Margin="0,8,0,4"
                   FontWeight="Bold" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenDumpButton" Content="📂 Open in Analyzer" Width="150"
                    Margin="0,0,5,0" Click="OpenDumpButton_Click" IsEnabled="False"/>
            <Button x:Name="CloseButton" Content="Close" Width="80"
                    Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

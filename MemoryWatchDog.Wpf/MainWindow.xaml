<Window x:Class="MemoryWatchDogApp.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MemoryWatchDogApp"
        xmlns:converters="clr-namespace:MemoryWatchDogApp.Converters"
        mc:Ignorable="d"
        Title=".NET MemoryWatchDog" Height="850" Width="1100" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:FormatBytesConverter x:Key="FormatBytesConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Process Selection -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition  Height="Auto" />
                <RowDefinition  Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProcessHeader" Grid.Column="0" FontWeight="Bold" FontSize="14"
                       Text="Process" VerticalAlignment="Center" Margin="0,0,0,3"/>
            <Button x:Name="SelectProcessButton" Grid.Row="1" Grid.Column="0" Content="Attach to Process"
                    Width="120" Click="SelectProcessButton_Click"
                    ToolTip="Open dialog to select a process"/>
            <TextBlock x:Name="SelectedProcessText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                       Margin="10,0,0,0" FontSize="14" Foreground="Blue"
                       Text="No process selected"/>
        </Grid>

        <!-- Mode TabControl -->
        <TabControl x:Name="ModeTabControl" Grid.Row="1" Margin="0,0,0,5" SelectionChanged="ModeTabControl_SelectionChanged">

            <!-- ==================== Manual Capture Tab ==================== -->
            <TabItem Header="📷 Manual Capture" x:Name="ManualModeTab">
                <StackPanel Margin="8">
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ExcludeSystemNamespacesCheckBox" Grid.Column="0" Margin="0,0,10,0"
                                  Content="Exclude System Namespaces" VerticalAlignment="Center"
                                  IsChecked="True"
                                  ToolTip="Exclude common system namespaces (System, Microsoft, Windows, etc.) from heap object results"/>
                        <CheckBox x:Name="AggregateObjectsCheckBox" Grid.Column="1" Margin="0,0,10,0"
                                  Content="Aggregate Objects" VerticalAlignment="Center"
                                  IsChecked="False"
                                  ToolTip="Aggregate heap objects by type name (faster and uses less memory. For a detailed view, uncheck this option)"/>
                        <CheckBox x:Name="CaptureDisplayValuesCheckBox" Grid.Column="2" Margin="0,0,10,0"
                                  Content="Capture Display Values" VerticalAlignment="Center"
                                  IsChecked="True"
                                  ToolTip="Capture display values for each object (can be slower for large heaps)"/>
                        <Button x:Name="AttachButton" Grid.Column="3" Content="Get Memory Snapshot" Width="150"
                                Click="AttachButton_Click" IsEnabled="False"/>
                        <Button x:Name="ForceGCButton" Grid.Column="4" Content="Force GC" Width="80"
                                Margin="5,0,0,0" Click="ForceGCButton_Click" IsEnabled="False"
                                ToolTip="Force garbage collection on the attached process"/>
                    </Grid>
                    <StackPanel x:Name="CaptureProgressPanel" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="CaptureProgressText" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Text="Objects: 0 | Types: 0" Foreground="DarkBlue"/>
                        <ProgressBar x:Name="CaptureProgressBar" Width="200" Height="16" IsIndeterminate="True"/>
                        <Button x:Name="CancelButton" Content="Cancel" Width="60"
                            Margin="5,0,0,0" Click="CancelButton_Click" IsEnabled="False"
                            ToolTip="Cancel the running capture"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ==================== Auto Watch Tab ==================== -->
            <TabItem Header="🔍 Auto Watch" x:Name="AutoModeTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Settings Row -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Interval (sec):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="AutoIntervalTextBox" Width="50" Text="60" VerticalAlignment="Center"
                                 ToolTip="Seconds between each lightweight snapshot (10–600)"/>
                        <TextBlock Text="Max Snapshots:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <TextBox x:Name="AutoMaxSnapshotsTextBox" Width="50" Text="20" VerticalAlignment="Center"
                                 ToolTip="Maximum number of snapshots to keep in the rolling window (5–100)"/>
                        <TextBlock Text="Warmup:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <TextBox x:Name="AutoWarmupTextBox" Width="50" Text="5" VerticalAlignment="Center"
                                 ToolTip="Number of snapshots to collect before starting leak analysis"/>
                        <TextBlock Text="Min Growth:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <TextBox x:Name="AutoMinGrowthTextBox" Width="50" Text="5" VerticalAlignment="Center"
                                 ToolTip="Minimum consecutive growths to flag a type as leak candidate"/>
                    </StackPanel>

                    <!-- Controls Row -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,5">
                        <Button x:Name="StartAutoWatchButton" Content="▶ Start Watching" Width="120"
                                DockPanel.Dock="Left" Click="StartAutoWatchButton_Click" IsEnabled="False"
                                ToolTip="Start automatic memory monitoring and leak detection"/>
                        <Button x:Name="StopAutoWatchButton" Content="⏹ Stop" Width="80"
                                DockPanel.Dock="Left" Margin="5,0,0,0" Click="StopAutoWatchButton_Click" IsEnabled="False"
                                ToolTip="Stop automatic memory monitoring"/>
                        <TextBlock x:Name="AutoWatchStatusText" VerticalAlignment="Center"
                                   Margin="15,0,0,0" Foreground="DarkBlue"
                                   FontFamily="Consolas" FontSize="12" DockPanel.Dock="Left"/>
                    </DockPanel>

                    <!-- Memory Graph -->
                    <Border Grid.Row="2" BorderBrush="#336699" BorderThickness="1" CornerRadius="3"
                            Background="#F0F4FA" Padding="4">
                        <local:MemoryGraphControl x:Name="MemoryGraph" />
                    </Border>

                    <!-- Detected Leaks Header -->
                    <DockPanel Grid.Row="3" Margin="0,8,0,3">
                        <TextBlock Text="Detected Leak Candidates" FontWeight="Bold" FontSize="13"
                                   Foreground="#C62828" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LeakCandidateCountText" Foreground="#C62828" FontWeight="Bold"
                                   Margin="6,0,0,0" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button x:Name="TakeLeakSnapshotButton" Content="📸 Detailed Snapshot of Suspects"
                                Width="220" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Click="TakeLeakSnapshotButton_Click" IsEnabled="False"
                                ToolTip="Take a targeted full snapshot of the detected leak candidate types"/>
                    </DockPanel>

                    <!-- Detected Leaks Grid -->
                    <DataGrid Grid.Row="4" x:Name="LeakCandidatesGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserSortColumns="True" MaxHeight="180"
                              HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceText}" Width="100"/>
                            <DataGridTextColumn Header="Type Name" Binding="{Binding TypeName}" Width="*"/>
                            <DataGridTextColumn Header="Initial Count" Binding="{Binding InitialCount}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Current Count" Binding="{Binding CurrentCount}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Growth" Binding="{Binding CountGrowth}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Growth/Interval" Binding="{Binding GrowthRatePerInterval, StringFormat='+{0:0.0}'}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Consecutive" Binding="{Binding ConsecutiveGrowthCount}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Stats Header -->
        <Grid Grid.Row="2" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatsHeader" Grid.Column="0" FontWeight="Bold" FontSize="14"
                       Text="Memory Statistics" VerticalAlignment="Center"/>

            <TextBlock x:Name="StatusText" Grid.Column="3" VerticalAlignment="Center"
                       Foreground="Gray"/>
        </Grid>

        <!-- Memory Stats Display -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Snapshots List -->
            <DockPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock DockPanel.Dock="Top" Text="Snapshots" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,4,0,0">
                    <Button x:Name="CompareSnapshotsButton" Content="Compare (Ctrl+Click 2)" Margin="0,0,0,3"
                            Click="CompareSnapshotsButton_Click" IsEnabled="False"
                            ToolTip="Select exactly two snapshots (Ctrl+Click) and compare them"/>
                    <Button x:Name="RemoveSnapshotButton" Content="Remove Selected"
                            Click="RemoveSnapshotButton_Click" IsEnabled="False"
                            ToolTip="Remove the selected snapshot from the list"/>
                </StackPanel>
                <ListBox x:Name="SnapshotsListBox" SelectionMode="Extended"
                         SelectionChanged="SnapshotsListBox_SelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ModeTag}" FontSize="10" Foreground="White"
                                               Background="{Binding ModeTagBrush}" Padding="3,1" Margin="0,0,5,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayDate}" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DisplayProcess}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <TabControl Grid.Column="1">
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock x:Name="OverviewText" TextWrapping="Wrap"
                                   FontFamily="Consolas" FontSize="13"
                                   Text="Select a process and click 'Get Memory Stats' to view statistics."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Heap Objects">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Filter Type Name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="ObjectsFilterTextBox" Grid.Column="1"
                                 TextChanged="ObjectsFilterTextBox_TextChanged"
                                 ToolTip="Type to filter heap objects by type name"/>
                        </Grid>
                        <DataGrid x:Name="ObjectsGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserSortColumns="True" HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray"
                              MouseDoubleClick="ObjectsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type Name" Binding="{Binding TypeName}" Width="*"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80"
                                                SortDirection="Descending">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total Size (bytes)" Binding="{Binding Size}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Element Type" Binding="{Binding ElementType}" Width="120"/>
                                <DataGridTextColumn Header="Assembly" Binding="{Binding AssemblyName}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Threads">
                    <DataGrid x:Name="ThreadsGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserSortColumns="True" HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray"
                          >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="Managed Thread ID" Binding="{Binding ManagedThreadId}" Width="140"/>
                            <DataGridTextColumn Header="OS Thread ID" Binding="{Binding OSThreadId}" Width="120"/>
                            <!--<DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180"/>-->
                            <DataGridTextColumn Header="CurrentException" Binding="{Binding CurrentExceptionType}" Width="180"/>
                            <DataGridTextColumn Header="StackFrames" Binding="{Binding StackFramesAll}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem x:Name="PotentialLeaksTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Potential Leaks" Foreground="#C62828" FontWeight="Bold"/>
                            <TextBlock x:Name="PotentialLeaksCountText" Foreground="Red" FontWeight="Bold" Margin="4,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="5"
                               Text="Objects that have been disposed but are still retained in memory. These are potential memory leaks."
                               Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"/>
                        <DataGrid x:Name="PotentialLeaksGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserSortColumns="True"
                              HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray"
                              MouseDoubleClick="PotentialLeaksGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Reason" Binding="{Binding LeakReason}" Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#7B1FA2"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Type Name" Binding="{Binding TypeName}" MinWidth="120" Width="*"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource FormatBytesConverter}}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Display Value" Binding="{Binding DisplayValue}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="References" Binding="{Binding ReferenceCount}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="Orange"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Element Type" Binding="{Binding ElementType}" Width="120"/>
                                <DataGridTextColumn Header="Assembly" Binding="{Binding AssemblyName}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal">
                <!--<Button x:Name="ExportTxtButton" Grid.Column="1" Content="Export TXT" Width="90"
                 Margin="0,0,5,0" Click="ExportTxtButton_Click" IsEnabled="False"
                 ToolTip="Export the current memory snapshot to a text file"/>-->
                <Button x:Name="ExportJsonButton" Grid.Column="2" Content="Export to file" Width="90"
                 Margin="0,0,10,0" Click="ExportJsonButton_Click" IsEnabled="False"
                 ToolTip="Export the current memory snapshot to a JSON file"/>
                <Button x:Name="ImportJsonButton" Content="Import from file" Width="90"
                 Margin="0,0,5,0" Click="ImportJsonButton_Click"
                 ToolTip="Load a memory snapshot from a JSON file"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

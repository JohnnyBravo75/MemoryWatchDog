<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MemoryWatchDogApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Botomatic</Company>
    <Product>.NET MemorySpy</Product>
    <Description>A WPF tool for monitoring and diagnosing .NET application memory usage, detecting leaks, and analyzing heap objects.</Description>
    <Copyright>Copyright © 2026 Botomatic</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icons8-spy-96.png</PackageIcon>
    <ApplicationIcon>icons8-spy-96.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="splashscreen.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icons8-spy-96.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\icons8-spy-96.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MemoryWatchDog\MemoryWatchDog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <SplashScreen Include="splashscreen.png" />
  </ItemGroup>

  <!--
    Dual-architecture publish.

    Automatic: Runs after every Release build (Debug builds are unaffected).
    Manual:    dotnet msbuild -t:PublishBoth /p:Configuration=Release
           or: .\Publish.ps1

    Produces:
      publish\x64\MemoryWatchDog.Wpf.exe
      publish\x86\MemoryWatchDog.Wpf.exe

    Guards against infinite recursion:
      RuntimeIdentifier is set by 'dotnet publish' so inner builds skip this target.
      _IsPublishBothInner is passed to nested invocations as extra safety.
  -->
  <PropertyGroup>
    <PublishBothOutputRoot Condition="'$(PublishBothOutputRoot)' == ''">$(MSBuildThisFileDirectory)..\publish</PublishBothOutputRoot>
    <PublishBothSelfContained Condition="'$(PublishBothSelfContained)' == ''">false</PublishBothSelfContained>
  </PropertyGroup>

  <Target Name="PublishBoth"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(RuntimeIdentifier)' == '' AND '$(_IsPublishBothInner)' != 'true'">

    <Message Importance="high" Text="" />
    <Message Importance="high" Text="===== Dual-Architecture Publish (automatic on Release build) =====" />

    <Message Importance="high" Text="Publishing win-x64 -> $(PublishBothOutputRoot)\x64" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; --configuration $(Configuration) --runtime win-x64 --self-contained $(PublishBothSelfContained) --output &quot;$(PublishBothOutputRoot)\x64&quot; /p:_IsPublishBothInner=true" />

    <Message Importance="high" Text="Publishing win-x86 -> $(PublishBothOutputRoot)\x86" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; --configuration $(Configuration) --runtime win-x86 --self-contained $(PublishBothSelfContained) --output &quot;$(PublishBothOutputRoot)\x86&quot; /p:_IsPublishBothInner=true" />

    <Message Importance="high" Text="===== Dual-Architecture Publish complete! =====" />
    <Message Importance="high" Text="  publish\x64\MemoryWatchDog.Wpf.exe" />
    <Message Importance="high" Text="  publish\x86\MemoryWatchDog.Wpf.exe" />
    <Message Importance="high" Text="" />
  </Target>

</Project>
